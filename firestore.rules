rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile matching
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(userId);
      
      // User transactions subcollection
      match /transactions/{txId} {
        allow read, write: if isOwner(userId) && isValidId(txId);
      }

      // User device sessions subcollection
      match /sessions/{sessionId} {
        allow read, write: if isOwner(userId) && isValidId(sessionId);
      }

      // User daily claims subcollection
      match /claims/{claimId} {
        allow read, write: if isOwner(userId) && isValidId(claimId);
      }
    }
  }
}
