# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PROJECT_ID / REOWN_PROJECT_ID: Official Reown WalletConnect v2 Cloud Project ID
PROJECT_ID="9eb28dc61f1cde5b93c657e530bcebec"
REOWN_PROJECT_ID="9eb28dc61f1cde5b93c657e530bcebec"
WALLETCONNECT_PROJECT_ID="9eb28dc61f1cde5b93c657e530bcebec"

# VITE_REOWN_PROJECT_ID: the actual variable read by the real Reown AppKit
# wallet connector (src/lib/appkit.ts). Only VITE_-prefixed vars are exposed
# to client code by Vite, so this is the one that matters for the wallet
# connect button. Get your own project id at https://dashboard.reown.com —
# the value above is a shared demo id and is rate-limited / not for production.
VITE_REOWN_PROJECT_ID="9eb28dc61f1cde5b93c657e530bcebec"

# VAULT_ENCRYPTION_SECRET: Encryption key for non-custodial wallet vault (AES-256)
VAULT_ENCRYPTION_SECRET="nexorum_vault_secure_key_2026_aes256_prod"

# ADMIN_API_TOKEN: Required bearer token for /api/v1/admin/* routes and admin-only
# airdrop actions (create/distribute). No default is provided on purpose — generate
# your own with e.g. `openssl rand -hex 32` and NEVER commit the real value.
ADMIN_API_TOKEN=""

# COINGECKO_API_KEY: Optional CoinGecko API Key for high rate limit market data
COINGECKO_API_KEY=""

# TELEGRAM_BOT_TOKEN: Telegram Bot Token for Telegram Login verification & Webhook notifications
TELEGRAM_BOT_TOKEN=""

# DATABASE_URL: Cloudflare D1 / SQLite / PostgreSQL Connection URI
DATABASE_URL="file:./nexorum_web3.db"

