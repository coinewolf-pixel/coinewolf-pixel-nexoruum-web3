# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# WALLETCONNECT_PROJECT_ID: WalletConnect Cloud v2 Project ID
WALLETCONNECT_PROJECT_ID="MY_WALLETCONNECT_PROJECT_ID"

# COINGECKO_API_KEY: Optional CoinGecko API Key for high rate limit market data
COINGECKO_API_KEY=""

# TELEGRAM_BOT_TOKEN: Telegram Bot Token for Telegram Login verification & Webhook notifications
TELEGRAM_BOT_TOKEN=""

# DATABASE_URL: Cloudflare D1 / SQLite / PostgreSQL Connection URI
DATABASE_URL="file:./nexorum_web3.db"

