# Copy this file to .env and fill in your own values. NEVER commit the real
# .env file (it's already in .gitignore).
#
# PRIVATE_KEY: your deployer wallet's private key. Use a DEDICATED wallet
# for this, funded only with testnet ETH from a faucet — never a wallet
# that holds real funds. In MetaMask: Account details -> Show private key.
PRIVATE_KEY=""

# SEPOLIA_RPC_URL: optional override. Defaults to a free public endpoint if
# left blank. For a more reliable deploy, get a free key from
# https://dashboard.alchemy.com or https://infura.io and use their Sepolia
# URL instead.
SEPOLIA_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"

# ETHERSCAN_API_KEY: optional, only needed if you want this project to
# auto-verify the contract source code on Sepolia Etherscan after deploy.
# Free key from https://etherscan.io/myapikey
ETHERSCAN_API_KEY=""
